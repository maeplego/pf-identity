# Copy to .env locally. Never commit .env.

# development (default) | staging | production
# staging/production reject IDENTITY_DEV_GENERATE_KEYS and memory store.
IDENTITY_ENV=development

IDENTITY_HTTP_ADDR=:8080
IDENTITY_ISSUER=http://localhost:8080
IDENTITY_COOKIE_SECURE=false
IDENTITY_DEV_GENERATE_KEYS=true
IDENTITY_STORE=memory

# staging/production example:
# IDENTITY_ENV=staging
# IDENTITY_DEV_GENERATE_KEYS=false
# IDENTITY_STORE=postgres
# IDENTITY_DATABASE_URL=postgres://idp:idp@db:5432/idp?sslmode=disable
# IDENTITY_RSA_PRIVATE_KEY_PATH=/run/secrets/idp_rsa.pem
# IDENTITY_COOKIE_SECURE=true   # required when IDENTITY_ENV=production

# Seed the sample RP (public + PKCE). Omit both to skip.
# IDENTITY_SEED_PUBLIC_CLIENT_ID=sample-rp
# IDENTITY_SEED_PUBLIC_CLIENT_NAME=Sample RP
# IDENTITY_SEED_PUBLIC_REDIRECT_URI=http://localhost:3001/callback
# Extra public clients for other portfolio apps (JSON array). Sample RP slots stay at 2.
# IDENTITY_SEED_EXTRA_CLIENTS=[{"id":"pf-finance-web","name":"Finance Web","redirectUri":"http://localhost:3014/callback"}]

# Admin API bearer token. Leave empty to keep /admin/api unauthorized.
# IDENTITY_ADMIN_TOKEN=change-me-locally

# Required when IDENTITY_STORE=postgres
# IDENTITY_DATABASE_URL=postgres://idp:idp@localhost:5432/idp?sslmode=disable

# Optional: load an existing PKCS#8 RSA key instead of generating one
# IDENTITY_RSA_PRIVATE_KEY_PATH=

IDENTITY_SESSION_TTL=8h
IDENTITY_CODE_TTL=1m
IDENTITY_ACCESS_TTL=15m
IDENTITY_REFRESH_TTL=168h
